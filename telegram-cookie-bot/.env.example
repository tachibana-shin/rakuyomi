# Copy to `.env` and fill in the values. Bun loads `.env` automatically, both
# for `bun run dev` and for `bun run dev:worker` (Wrangler reads it too).

# Telegram bot token from @BotFather. Required for the bot; the cookie API
# works without it.
BOT_TOKEN=your_telegram_bot_token

# Public base URL of the deployment. Used to build OAuth redirect URIs and to
# register the Telegram webhook, so it must be reachable from the internet.
PUBLIC_URL=https://your-server-url.example.com

# Turso (libSQL) database. Required.
TURSO_DB_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Shared secret for POST /webhook. When set, Telegram sends it in the
# X-Telegram-Bot-Api-Secret-Token header and the endpoint rejects anything
# else. Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# A Cloudflare Worker cannot long-poll, so webhooks are always used when
# deployed. Setting this to "false" only matters for local development, where
# `bun run dev` long-polls anyway.
USE_WEBHOOK=true

# OAuth tracking bridge - AniList
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# OAuth tracking bridge - MyAnimeList
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# OAuth tracking bridge - Shikimori
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=

# OAuth tracking bridge - Bangumi
BANGUMI_CLIENT_ID=
BANGUMI_CLIENT_SECRET=

# OAuth tracking bridge - MangaBaka (PKCE S256 + client secret, per its
# .well-known/openid-configuration - the token endpoint has no "none" auth method)
MANGABAKA_CLIENT_ID=
MANGABAKA_CLIENT_SECRET=
