{
  "name": "rakuyomi-cookie-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot + HTTP API for syncing browser cookies to KOReader (RakuYomi), running on Cloudflare Workers",
  "scripts": {
    "dev": "bun run main.ts",
    "dev:worker": "bun x wrangler dev",
    "deploy": "bun x wrangler deploy",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "types": "bun x wrangler types"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.4.0",
    "@hono/zod-validator": "0.9.0",
    "@libsql/client": "0.17.4",
    "grammy": "1.34.1",
    "hono": "4.12.28",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@hono/node-server": "^2.1.4",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0",
    "wrangler": "^4.149.0"
  }
}
